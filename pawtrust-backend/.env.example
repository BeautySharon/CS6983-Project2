# MongoDB connection string (Atlas). Never commit the real value.
PawTrust_DB_URI=mongodb+srv://<user>:<password>@<cluster>/
# Database name: pawtrust_dev locally, pawtrust_test for tests, pawtrust_prod only on Render
PawTrust_db=pawtrust_dev
# Long random string used to sign JWTs
JWT_SECRET=change-me
PORT=8000
# Deployed frontend URL (Vercel); localhost is always allowed outside production
CORS_ORIGIN=http://localhost:5173
# Optional: allow this project's Vercel PR previews,
# https://<VERCEL_PROJECT>-<hash>-<VERCEL_SCOPE>.vercel.app
VERCEL_PROJECT=
VERCEL_SCOPE=
# Set to production on Render (disables the localhost CORS exception)
NODE_ENV=development
